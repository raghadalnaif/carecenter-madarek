[Unit]
Description=Madarek API (data storage server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/madarek/server
ExecStart=/usr/bin/node /var/www/madarek/server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=127.0.0.1
Environment=DB_PATH=/var/www/madarek/server/data.db
# PLATFORM_TOKEN يُقرأ من /etc/madarek-api.env (يُولَّد تلقائياً بواسطة setup.sh)
EnvironmentFile=/etc/madarek-api.env

[Install]
WantedBy=multi-user.target
